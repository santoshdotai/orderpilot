        "specifyBody": "json",
        "jsonBody": "={\"customer_id\": \"{{$node['Create quotations row'].json.customer_id || $node['Create quotations row'].json.customerId || $node['Webhook'].json.body.customerId || $node['Webhook'].json.body.customer_id || ''}}\", \"remind_at\": \"={{new Date().toISOString()}}\", \"reason\": \"Quotation awaiting approval\", \"done\": false}"
      },
      "id": "CreateFollowUp",
      "name": "Create follow-up row",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1680,
        40
