          ]
        }
      },
      "id": "WhisperTranscription",
      "name": "Whisper HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -260,
        -80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key={{$env.GEMINI_API_KEY}}",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [{\n      \"text\": \"You are an order-extraction assistant for a B2B WhatsApp seller. Return strict JSON with keys: products[{sku?, name, qty}], urgency (low|medium|high), delivery({address?, date?}).\\n\\nCustomer message:\\n\\\"\\\"\\\"\\n{{$json.transcript || $json.text || $json.body.body}}\\n\\\"\\\"\\\"\"\n    }]\n  }],\n  \"generationConfig\": {\n    \"responseMimeType\": \"application/json\"\n  }\n}"
      },
      "id": "GeminiExtraction",
      "name": "Gemini Extraction",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        20,
        40
      ]
    },
    {
      "parameters": {
        "jsCode": "const rawText = $json.candidates?.[0]?.content?.parts?.[0]?.text || '{}';\nconst payload = JSON.parse(rawText.replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '').replace(/```$/i, '').trim());\nreturn [{ json: { ...$json, extraction: payload } }];"
      },
      "id": "ParseExtractionJson",
      "name": "Parse extraction JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        40
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/ai_extractions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Prefer",
              "value": "return=representation"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\"message_id\": \"{{$node['Webhook'].json.body.messageId}}\", \"products\": {{$json.extraction.products}}, \"urgency\": \"{{$json.extraction.urgency}}\", \"delivery\": {{$json.extraction.delivery}}, \"raw_response\": {{$json.extraction}}}"
      },
      "id": "InsertAiExtraction",
      "name": "Supabase ai_extractions insert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        40
      ]
    },
    {
      "parameters": {
        "jsCode": "function parseJsonArray(value) {\n  if (Array.isArray(value)) {\n    return value;\n  }\n\n  if (typeof value === 'string') {\n    try {\n      const cleaned = value.startsWith('=') ? value.slice(1).trim() : value.trim();\n      const parsed = JSON.parse(cleaned);\n      return Array.isArray(parsed) ? parsed : [];\n    } catch {\n      return [];\n    }\n  }\n\n  return [];\n}\n\nconst products = parseJsonArray($json.extraction.products);\nconst lineItems = products.map((product, index) => ({\n  product_name: product.name,\n  qty: Number(product.qty || 1),\n  temp_id: index + 1,\n}));\nreturn [{ json: { ...$json, lineItems } }];"
      },
      "id": "PrepareDraftQuote",
      "name": "Match products and build draft",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        40
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/rpc/create_orderpilot_quotation_draft",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\"message_id\": \"{{$node['Webhook'].json.body.messageId}}\", \"line_items\": {{$json.lineItems}}}"
      },
      "id": "CreateQuotationDraft",
      "name": "Create quotations row",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        40
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/functions/v1/send-whatsapp",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\"to\": \"{{$node['Webhook'].json.body.from}}\", \"templateName\": \"{{$env.INTERAKT_ORDER_RECEIVED_TEMPLATE_NAME || 'order_received'}}\", \"bodyValues\": [\"{{$node['Webhook'].json.body.profileName || 'there'}}\", \"{{$node['Match products and build draft'].json.lineItems && Array.isArray($node['Match products and build draft'].json.lineItems) ? $node['Match products and build draft'].json.lineItems.map((item) => (item.product_name || 'Item') + ' x ' + (item.qty || 1)).join(', ') : 'No items extracted'}}\", \"{{$node['Parse extraction JSON'].json.extraction && $node['Parse extraction JSON'].json.extraction.urgency ? $node['Parse extraction JSON'].json.extraction.urgency : 'medium'}}\", \"{{$node['Parse extraction JSON'].json.extraction && $node['Parse extraction JSON'].json.extraction.delivery ? [($node['Parse extraction JSON'].json.extraction.delivery.address || ''), ($node['Parse extraction JSON'].json.extraction.delivery.date || '')].filter(Boolean).join(' | ') || 'Delivery details pending' : 'Delivery details pending'}}\"], \"customerId\": \"{{$json.customer_id || $json.customerId || $node['Webhook'].json.body.customerId || ''}}\"}"
      },
      "id": "AckCustomer",
      "name": "Send order received",
      "type": "n8n-nodes-base.httpRequest",
