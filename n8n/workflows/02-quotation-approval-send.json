              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            }
          ]
        }
      },
      "id": "FetchQuotationBundle",
      "name": "Fetch quotation bundle",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -260,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "function parseJsonArray(value) {\n  if (Array.isArray(value)) {\n    return value;\n  }\n\n  if (typeof value === 'string') {\n    try {\n      const cleaned = value.startsWith('=') ? value.slice(1).trim() : value.trim();\n      const parsed = JSON.parse(cleaned);\n      return Array.isArray(parsed) ? parsed : [];\n    } catch {\n      return [];\n    }\n  }\n\n  return [];\n}\n\nconst quote = Array.isArray($json) ? $json[0] : $json;\nconst items = parseJsonArray(quote.quotation_items);\nconst lines = items.map((item) => `- ${item.products?.name || 'Item'} x ${item.qty} @ ${item.unit_price}`).join('\\n');\nconst message = `Your quotation is ready.\\n\\n${lines}\\n\\nTotal: INR ${quote.total}`;\nreturn [{ json: { quote, message } }];"
      },
      "id": "RenderQuoteMessage",
      "name": "Normalize quotation bundle",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/functions/v1/invoice-engine",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\"quotationId\": \"{{$json.quote.id}}\"}"
      },
      "id": "GenerateInvoice",
      "name": "Generate invoice PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        120
      ]
    },
    {
      "parameters": {
        "jsCode": "const invoiceResponse = $json;\nconst quote = $node['Normalize quotation bundle'].json.quote;\nconst customer = Array.isArray(quote.customers) ? quote.customers[0] : quote.customers;\n\nconst customerName = customer?.name || customer?.whatsapp_phone || 'Customer';\nconst phoneNumber = customer?.whatsapp_phone || '';\nconst customerId = customer?.id || quote.customer_id || '';\nconst invoiceTemplateName = (typeof process !== 'undefined' && process.env?.INTERAKT_INVOICE_READY_TEMPLATE_NAME) || 'invoice_ready';\n\nconst dueDate = new Date();\ndueDate.setDate(dueDate.getDate() + 7);\nconst dueDateText = dueDate.toISOString().slice(0, 10);\nconst invoiceNumber = invoiceResponse.invoiceNumber || '';\nconst total = Number(invoiceResponse.total ?? quote.total ?? 0);\nconst tax = Number(invoiceResponse.taxTotal ?? invoiceResponse.tax ?? 0);\nconst invoice = {\n  id: invoiceResponse.invoiceId || '',\n  invoice_number: invoiceNumber,\n  customer_id: customerId,\n  total,\n  tax,\n  status: invoiceResponse.status || 'draft',\n  due_date: dueDateText,\n  pdf_url: invoiceResponse.pdfUrl || '',\n};\n\nconst bodyValues = [\n  customerName,\n  invoiceNumber,\n  String(total),\n  dueDateText,\n  invoice.pdf_url,\n];\n\nreturn [{\n  json: {\n    ...invoiceResponse,\n    invoice,\n    to: phoneNumber,\n    customerId,\n    templateName: invoiceTemplateName,\n    bodyValues,\n  },\n}];"
      },
      "id": "BuildInvoiceWhatsAppMessage",
      "name": "Build invoice template payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/functions/v1/send-whatsapp",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
