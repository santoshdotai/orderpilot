            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\"to\": \"{{$json.to}}\", \"templateName\": \"{{$json.templateName}}\", \"bodyValues\": {{$json.bodyValues}}, \"customerId\": \"{{$json.customerId}}\"}"
      },
      "id": "SendQuotation",
      "name": "Send invoice via Interakt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
