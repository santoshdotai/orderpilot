{
  "name": "OrderPilot - Follow-up Cron",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "ScheduleTrigger",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -360,
        120
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/follow_ups?done=is.false&customer_id=not.is.null&select=id,customer_id,reason,remind_at,customers!inner(whatsapp_phone,name)&remind_at=lte.{{new Date().toISOString()}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            }
          ]
        }
      },
      "id": "QueryDueFollowUps",
      "name": "Query due follow-ups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -100,
        120
      ]
    },
    {
      "parameters": {
        "batchSize": 1
      },
      "id": "LoopFollowUps",
      "name": "Loop follow-ups",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        120,
        120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/functions/v1/send-whatsapp",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: (Array.isArray($json.customers) ? $json.customers[0]?.whatsapp_phone : $json.customers?.whatsapp_phone) || '', templateName: $env.INTERAKT_FOLLOWUP_TEMPLATE_NAME || 'followup_regarding_case', bodyValues: [Array.isArray($json.customers) ? $json.customers[0]?.name || 'Customer' : $json.customers?.name || 'Customer', $json.remind_at ? new Date($json.remind_at).toISOString().slice(0, 10) : new Date().toISOString().slice(0, 10), $json.reason || 'We are waiting on your confirmation.'], customerId: $json.customer_id || '' }) }}"
      },
      "id": "SendReminder",
      "name": "Send follow-up via Interakt",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        360,
        120
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/follow_ups?id=eq.{{$node['Loop follow-ups'].json.id}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={\"done\": true}"
      },
      "id": "MarkFollowUpDone",
      "name": "Mark done",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        120
      ]
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [
        [
          {
            "node": "Query due follow-ups",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query due follow-ups": {
      "main": [
        [
          {
            "node": "Loop follow-ups",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop follow-ups": {
      "main": [
        [
          {
            "node": "Send follow-up via Interakt",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Send follow-up via Interakt": {
      "main": [
        [
          {
            "node": "Mark done",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mark done": {
      "main": [
        [
          {
            "node": "Loop follow-ups",
            "type": "main",
            "index": 1
          }
        ]
      ]
    }
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "follow-up-v1"
}
