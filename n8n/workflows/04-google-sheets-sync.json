{
  "name": "OrderPilot - Google Sheets Sync",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "orderpilot-sheets-sync",
        "responseMode": "responseNode"
      },
      "id": "SheetsSyncWebhook",
      "name": "Sheets sync webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -280,
        140
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json ?? {};\n\nconst candidateInvoice =\n  (body.invoice && typeof body.invoice === 'object' ? body.invoice : null) ??\n  (body.data && typeof body.data === 'object' && body.data.invoice ? body.data.invoice : null) ??\n  (body.entity === 'invoice' ? body : null) ??\n  ($json.invoice && typeof $json.invoice === 'object' ? $json.invoice : null);\n\nconst invoice = candidateInvoice && typeof candidateInvoice === 'object' ? candidateInvoice : null;\n\nif (!invoice || !invoice.id) {\n  throw new Error(`invoice is required for sheet sync. Received keys: ${Object.keys(body).join(', ') || '(none)'}`);\n}\n\nreturn [{\n  json: {\n    entity: 'invoice',\n    sheetName: 'Invoices',\n    invoice: {\n      id: invoice.id,\n      invoice_number: invoice.invoice_number ?? '',\n      customer_id: invoice.customer_id ?? '',\n      total: invoice.total ?? 0,\n      tax: invoice.tax ?? 0,\n      status: invoice.status ?? 'draft',\n      due_date: invoice.due_date ?? '',\n      pdf_url: invoice.pdf_url ?? '',\n    },\n  },\n}];"
      },
      "id": "ResolveSheetDestination",
      "name": "Resolve sheet destination",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -20,
        140
      ]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": "={{$env.GOOGLE_SHEETS_DOCUMENT_ID}}",
        "sheetName": "={{$json.sheetName}}",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{$json.invoice.id}}",
            "invoice_number": "={{$json.invoice.invoice_number}}",
            "customer_id": "={{$json.invoice.customer_id}}",
            "total": "={{$json.invoice.total}}",
            "tax": "={{$json.invoice.tax}}",
            "status": "={{$json.invoice.status}}",
            "due_date": "={{$json.invoice.due_date}}",
            "pdf_url": "={{$json.invoice.pdf_url}}"
          }
        }
      },
      "id": "GoogleSheetsSync",
      "name": "Google Sheets append/update",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        240,
        140
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/sheet_sync_log",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ entity_name: 'invoice', entity_id: $json.id, sheet_name: 'Invoices', direction: 'push', row_hash: JSON.stringify($json) }) }}"
      },
      "id": "WriteSheetSyncLog",
      "name": "Write sheet sync log",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        140
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"status\":\"synced\"}"
      },
      "id": "RespondSheetsWebhook",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        760,
        140
      ]
    }
  ],
  "connections": {
    "Sheets sync webhook": {
      "main": [
        [
          {
            "node": "Resolve sheet destination",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Resolve sheet destination": {
      "main": [
        [
          {
            "node": "Google Sheets append/update",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets append/update": {
      "main": [
        [
          {
            "node": "Write sheet sync log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write sheet sync log": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "sheets-sync-v1"
}
